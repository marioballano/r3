{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": [
    "server",
    "scripts",
    "vite.config.ts",
    "src/net/client.ts",
    "src/net/session.ts",
    "src/net/graph.ts",
    "src/types.ts",
    "src/net/wasm-runtime.ts",
    "src/net/entropy.ts"
  ]
}
