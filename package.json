{
  "name": "r3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "r3 — navigate binaries in 3D. A cyberpunk, artistic front end for radare2.",
  "scripts": {
    "dev": "concurrently -k -n srv,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "snap": "tsx scripts/snap.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.2",
    "gsap": "^3.12.7",
    "postprocessing": "^6.37.0",
    "three": "^0.171.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
